<view class="clipboard-page" style="padding-bottom: {{bottomInset + 40}}px;">
  <view class="nav" style="padding-top: {{navTop}}px; height: {{navHeight}}px; padding-right: {{navRightInset}}px;">
    <button size="mini" class="back" bindtap="onBack" aria-label="返回现实捕捉页">‹</button>
    <view class="nav__title">
      <text>世界粘贴板</text>
      <text class="nav__subtitle">World Clipboard</text>
    </view>
  </view>

  <view class="hero">
    <view class="nav__type">{{typeLabel}}</view>
    <view class="hero__glow"></view>
    <object-preview
      type="{{item.type}}"
      color-hex="{{colorHex}}"
      preview-image="{{previewImage}}"
    />
    <view class="capture-badge"><text class="capture-badge__dot"></text>已复制到剪贴板</view>
  </view>

  <view wx:if="{{item.type === 'color'}}" class="color-data">
    <view class="color-data__swatch" style="background: {{colorHex}};"></view>
    <view>
      <text class="color-data__hex">{{colorHex}}</text>
      <text class="color-data__rgb">RGB · {{rgbText}}</text>
    </view>
  </view>

  <view class="templates-section">
    <view class="section-heading">
      <view>
        <text class="eyebrow">PASTE PLUGINS</text>
        <text class="section-title">转换为创意模板</text>
      </view>
      <text class="section-index">01</text>
    </view>

    <view class="template-grid">
      <view wx:for="{{templates}}" wx:key="id" class="template-cell template-cell--{{item.widthClass}}">
        <template-card template="{{item}}" bindselect="onTemplateSelect" />
      </view>
    </view>
  </view>

  <view wx:if="{{showPerler}}" id="perler-result" class="perler-section">
    <view class="section-heading">
      <view>
        <text class="eyebrow">PERLER RESULT</text>
        <text class="section-title">{{perlerSettings.size}} × {{perlerSettings.size}} 拼豆图纸</text>
      </view>
      <text class="section-index">02</text>
    </view>

    <view class="perler-controls">
      <view class="perler-control-row">
        <text class="perler-control-label">尺寸</text>
        <button size="mini" wx:for="{{perlerSizes}}" wx:key="*this" class="perler-option {{perlerSettings.size === item ? 'perler-option--active' : ''}}" data-setting="size" data-value="{{item}}" bindtap="onPerlerOptionSelect" disabled="{{perlerStatus === 'loading'}}">{{item}} 格</button>
      </view>
      <view class="perler-control-row">
        <text class="perler-control-label">风格</text>
        <button size="mini" wx:for="{{perlerStyles}}" wx:key="id" class="perler-option {{perlerSettings.style === item.id ? 'perler-option--active' : ''}}" data-setting="style" data-value="{{item.id}}" bindtap="onPerlerOptionSelect" disabled="{{perlerStatus === 'loading'}}">{{item.label}}</button>
      </view>
      <view class="perler-control-row">
        <text class="perler-control-label">色数</text>
        <button size="mini" wx:for="{{perlerLimits}}" wx:key="*this" class="perler-option {{perlerSettings.maxColors === item ? 'perler-option--active' : ''}}" data-setting="maxColors" data-value="{{item}}" bindtap="onPerlerOptionSelect" disabled="{{perlerStatus === 'loading'}}">≤ {{item}}</button>
      </view>
      <text class="perler-note">照片默认 48 格 · 透明位置不放豆 · 小字建议 64 格</text>
    </view>

    <view wx:if="{{perlerStatus === 'loading'}}" class="perler-state" aria-label="正在从真实抠图生成拼豆">
      <view class="perler-state__pulse"></view>
      <text class="perler-state__title">正在读取真实抠图</text>
      <text class="perler-state__hint">裁切 · 采样 · 色卡量化</text>
    </view>

    <view wx:elif="{{perlerStatus === 'error'}}" class="perler-state perler-state--error">
      <text class="perler-state__mark">!</text>
      <text class="perler-state__title">{{perlerError}}</text>
      <text class="perler-state__hint">返回相机，将光标放在物体内部重新抓取</text>
    </view>

    <block wx:elif="{{perlerStatus === 'ready'}}">
    <view class="perler-view-switch">
      <button size="mini" class="perler-option {{perlerView === 'beads' ? 'perler-option--active' : ''}}" data-mode="beads" bindtap="onPerlerViewSelect">拼豆效果</button>
      <button size="mini" class="perler-option {{perlerView === 'chart' ? 'perler-option--active' : ''}}" data-mode="chart" bindtap="onPerlerViewSelect">色号图纸</button>
      <button wx:if="{{perlerPreviewImage}}" size="mini" class="perler-option" bindtap="onPerlerPreview" disabled="{{previewOpening}}" aria-label="放大查看当前拼豆图纸">放大 ↗</button>
    </view>
    <text class="perler-palette-label">{{paletteLabel}}</text>
    <view class="perler-card">
      <image wx:if="{{perlerPreviewImage}}" src="{{perlerPreviewImage}}" class="perler-preview" mode="widthFix" bindtap="onPerlerPreview" aria-label="点击放大查看拼豆效果或色号图纸" />
      <view wx:else class="perler-grid" aria-label="{{perler.size}}乘{{perler.size}}拼豆预览">
        <view class="perler-rows">
          <view wx:for="{{perlerRows}}" wx:for-item="row" wx:key="key" class="perler-row">
            <view
              wx:for="{{row.cells}}"
              wx:for-item="cell"
              wx:key="key"
              class="bead {{cell.empty ? 'bead--empty' : ''}}"
              style="background: {{cell.color}};"
            ></view>
          </view>
        </view>
      </view>

      <view class="perler-meta">
        <view class="meta-item"><text class="meta-label">GRID</text><text class="meta-value">{{perler.size}} × {{perler.size}}</text></view>
        <view class="meta-item"><text class="meta-label">COLORS</text><text class="meta-value">{{perler.colors.length}}</text></view>
        <view class="meta-item"><text class="meta-label">BEADS</text><text class="meta-value">{{perler.totalBeads}}</text></view>
      </view>
    </view>
    <text class="perler-note">MARD 色号来自开源色卡；实物颜色会受批次与屏幕影响。</text>

    <view class="palette-list">
      <view wx:for="{{perler.colors}}" wx:key="id" class="palette-row">
        <view class="palette-main">
          <view class="palette-dot" style="background: {{item.hex}};"></view>
          <view><text class="palette-name">{{item.name}}</text><text class="palette-code">{{item.id}} · {{item.hex}}</text></view>
        </view>
        <text class="palette-count">× {{item.count}}</text>
      </view>
    </view>
    </block>
  </view>

  <view class="footer">CTRL+C THE REAL WORLD · CTRL+V ANYWHERE</view>
</view>
