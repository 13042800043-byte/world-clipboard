<view class="camera-page">
  <view
    class="interaction-layer"
    catchtouchstart="onTouchStart"
    catchtouchmove="onTouchMove"
    catchtouchend="onTouchEnd"
    catchtouchcancel="onTouchCancel"
  >
  <canvas
    wx:if="{{useVisionKit && !useMockScene && visionCanvasMounted}}"
    class="camera-feed"
    type="webgl"
    id="visionkit-canvas"
    aria-label="VisionKit 实时手势画面"
  ></canvas>

  <camera
    wx:elif="{{!useVisionKit && !useMockScene}}"
    class="camera-feed"
    device-position="back"
    flash="off"
    mode="normal"
    frame-size="small"
    bindinitdone="onCameraReady"
    binderror="onCameraError"
  ></camera>

  <image wx:if="{{candidateOutline && !finalCapturing}}" class="candidate-outline {{isGrabbed ? 'candidate-outline--grabbed' : ''}}" src="{{candidateOutline}}" mode="scaleToFill" />

  <view wx:if="{{useMockScene}}" class="mock-scene" aria-label="摄像头模拟画面">
    <view class="mock-scene__light"></view>
    <view class="mock-scene__plant">
      <view class="mock-scene__leaf mock-scene__leaf--one"></view>
      <view class="mock-scene__leaf mock-scene__leaf--two"></view>
      <view class="mock-scene__pot">GOOD<text>THINGS</text></view>
    </view>
    <view class="mock-scene__table"></view>
  </view>

  <view
    wx:if="{{!useVisionKit || handDetected || isGrabbed}}"
    class="captured captured--{{mode}} {{isGrabbed ? 'captured--grabbed' : ''}} {{isCopying ? 'captured--copying' : ''}}"
    style="left: {{objectX * 100}}%; top: {{objectY * 100}}%;"
    aria-label="空间选择区域"
  >
    <view class="selection-reticle selection-reticle--{{mode}}">
      <view class="selection-reticle__corner selection-reticle__corner--tl"></view>
      <view class="selection-reticle__corner selection-reticle__corner--tr"></view>
      <view class="selection-reticle__corner selection-reticle__corner--bl"></view>
      <view class="selection-reticle__corner selection-reticle__corner--br"></view>
    </view>
  </view>

  <spatial-cursor
    x="{{cursorX}}"
    y="{{cursorY}}"
    gesture="{{gesture}}"
    visible="{{(!useVisionKit && debugMode) || handDetected || isGrabbed}}"
  />

  <view wx:if="{{coordinateDebug}}" class="coordinate-debug">
    <view class="coordinate-debug__raw" style="left: {{rawCursorX * 100}}%; top: {{rawCursorY * 100}}%;"></view>
    <view class="coordinate-debug__filtered" style="left: {{filteredCursorX * 100}}%; top: {{filteredCursorY * 100}}%;"></view>
    <view wx:if="{{isGrabbed || isCopying}}" class="coordinate-debug__lock" style="left: {{selectionX * 100}}%; top: {{selectionY * 100}}%;">+</view>
    <view class="coordinate-debug__panel" style="top: {{navHeight + 12}}px;">
      <text>RAW 橙圈 · FILTER 绿圈 · LOCK 十字</text>
      <text>{{debugGesture}}</text>
      <text>{{debugTelemetry}}</text>
      <button size="mini" class="gesture-export" catchtouchstart="onDebugTouch" catchtouchmove="onDebugTouch" catchtouchend="onDebugTouch" catchtap="onExportGestureTelemetry">输出最近 10 秒</button>
      <text>{{debugPoint}}</text>
      <view wx:if="{{debugFrame}}" class="coordinate-debug__frame" style="height: {{180 * debugFrameHeight / debugFrameWidth}}rpx;">
        <image src="{{debugFrame}}" mode="scaleToFill" />
        <view class="coordinate-debug__prompt" style="left: {{framePointX * 100}}%; top: {{framePointY * 100}}%;">+</view>
      </view>
    </view>
  </view>

  <view class="instruction {{isGrabbed ? 'instruction--active' : ''}}">
    <text wx:if="{{showDebugControls}}" class="instruction__state">{{gesture}}</text>
    <text>{{finalCapturing ? '已锁定目标 · 稳住手机，获取高清画面' : status}}</text>
  </view>
  </view>

  <view class="topbar" style="padding-top: {{navTop}}px; height: {{navHeight}}px; padding-right: {{navRightInset}}px;">
    <view>
      <view class="brand">世界粘贴板</view>
      <view class="brand-subtitle">{{showDebugControls ? handStatus : 'World Clipboard'}}</view>
    </view>
    <button wx:if="{{showDebugControls}}" size="mini" class="debug-chip" catchtap="onToggleScene">
      {{useMockScene ? 'MOCK' : 'CAMERA'}}
    </button>
  </view>

  <view class="bottom-controls" style="bottom: {{bottomInset + 22}}px;">
    <capture-mode-selector active="{{mode}}" bindchange="onModeChange" />
    <text class="bottom-hint">{{useVisionKit ? '拇指 + 食指对捏 · 保持 · 移动 · 张开' : '按住 · 移动 · 松开'}}</text>
  </view>

  <view class="clipboard-target {{isCopying ? 'clipboard-target--active' : ''}}">
    <view class="clipboard-target__paper"></view>
  </view>
</view>
