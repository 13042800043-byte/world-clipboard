.camera-page {
  position: relative;
  width: 100vw;
  height: 100vh;
  overflow: hidden;
  color: #ffffff;
  background: #17191a;
}

.interaction-layer { position: absolute; inset: 0; }

.coordinate-debug { position: absolute; inset: 0; z-index: 19; pointer-events: none; }
.coordinate-debug__raw { position: absolute; width: 18rpx; height: 18rpx; border: 2rpx solid #e9b67d; border-radius: 50%; transform: translate(-50%, -50%); }
.coordinate-debug__filtered { position: absolute; width: 26rpx; height: 26rpx; border: 2rpx solid #9ee5b7; border-radius: 50%; transform: translate(-50%, -50%); }
.gesture-export { pointer-events: auto; margin: 8rpx 0 0; padding: 0 12rpx; width: 210rpx; color: #fff; background: rgba(255,255,255,.15); font-size: 19rpx; line-height: 44rpx; }
.coordinate-debug__lock, .coordinate-debug__prompt { position: absolute; color: #e9b67d; font-size: 32rpx; font-weight: 700; line-height: 1; transform: translate(-50%, -50%); text-shadow: 0 1rpx 4rpx #111; }
.coordinate-debug__panel { position: absolute; top: calc(env(safe-area-inset-top) + 126rpx); left: 24rpx; max-width: 650rpx; padding: 12rpx; border-radius: 16rpx; background: rgba(0, 0, 0, .42); }
.coordinate-debug__panel text { display: block; font-size: 17rpx; line-height: 1.6; color: rgba(255, 255, 255, .8); }
.coordinate-debug__frame { position: relative; width: 180rpx; margin-top: 10rpx; overflow: hidden; border-radius: 8rpx; }
.coordinate-debug__frame image { width: 100%; height: 100%; }

.camera-feed,
.mock-scene { position: absolute; inset: 0; width: 100%; height: 100%; }

.mock-scene {
  overflow: hidden;
  background: linear-gradient(145deg, #91968f 0%, #565a58 46%, #363a39 100%);
}

.mock-scene__light {
  position: absolute;
  top: -140rpx;
  right: -80rpx;
  width: 620rpx;
  height: 780rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.32);
  filter: blur(80rpx);
}

.mock-scene__plant { position: absolute; top: 230rpx; left: 60rpx; width: 240rpx; height: 440rpx; opacity: 0.74; }
.mock-scene__leaf { position: absolute; width: 126rpx; height: 176rpx; border-radius: 80% 12% 75% 12%; background: #304d2d; }
.mock-scene__leaf--one { top: 0; left: 30rpx; transform: rotate(-28deg); }
.mock-scene__leaf--two { top: 82rpx; right: 0; transform: rotate(46deg); }
.mock-scene__pot { position: absolute; bottom: 0; left: 42rpx; display: flex; flex-direction: column; justify-content: center; width: 166rpx; height: 186rpx; color: rgba(20, 20, 20, 0.6); font-size: 21rpx; font-weight: 700; text-align: center; background: #b9b2a6; transform: perspective(220rpx) rotateX(-5deg); }
.mock-scene__pot text { font-size: 17rpx; letter-spacing: 3rpx; }
.mock-scene__table { position: absolute; left: -10%; bottom: -8%; width: 120%; height: 41%; background: linear-gradient(170deg, #ac8e6e, #765e49); transform: skewY(-4deg); }

.topbar {
  box-sizing: border-box;
  position: absolute;
  z-index: 20;
  top: 0;
  left: 0;
  right: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 32rpx;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0.42), transparent);
}

.brand { font-size: 30rpx; font-weight: 700; letter-spacing: 1rpx; }
.brand-subtitle { margin-top: 2rpx; color: rgba(255, 255, 255, 0.72); font-size: 18rpx; }

.debug-chip {
  box-sizing: border-box;
  flex-shrink: 0;
  min-width: 118rpx;
  height: 54rpx;
  margin: 0;
  padding: 0 18rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  border-radius: 28rpx;
  color: #ffffff;
  font-size: 18rpx;
  line-height: 52rpx;
  letter-spacing: 2rpx;
  background: rgba(0, 0, 0, 0.28);
}
.debug-chip::after { border: 0; }

.captured {
  position: absolute;
  z-index: 8;
  width: 176rpx;
  height: 176rpx;
  pointer-events: none;
  transform: translate(-50%, -50%);
  transform-origin: center;
  transition: transform 150ms ease, filter 150ms ease, opacity 480ms ease;
  filter: drop-shadow(0 8rpx 14rpx rgba(0, 0, 0, 0.18));
}

.captured--grabbed { transform: translate(-50%, -50%) scale(0.94); filter: drop-shadow(0 0 16rpx rgba(255, 255, 255, 0.95)); transition: transform 150ms ease, filter 150ms ease; }
.captured--copying { left: 90% !important; top: 12% !important; opacity: 0.08; transform: translate(-50%, -50%) scale(0.14) rotate(8deg); transition: left 560ms cubic-bezier(.2,.8,.2,1), top 560ms cubic-bezier(.2,.8,.2,1), opacity 480ms ease, transform 560ms ease; }

.selection-reticle { position: absolute; inset: 0; border-radius: 50%; background: rgba(255, 255, 255, 0.04); box-shadow: inset 0 0 0 1rpx rgba(255, 255, 255, 0.22); }
.selection-reticle--color { border-radius: 50%; background: rgba(255, 255, 255, 0.14); backdrop-filter: blur(2rpx); }
.selection-reticle--contour { border-radius: 28rpx; background: transparent; }
.selection-reticle__corner { position: absolute; width: 38rpx; height: 38rpx; border-color: rgba(255, 255, 255, 0.94); border-style: solid; }
.selection-reticle__corner--tl { top: 0; left: 0; border-width: 4rpx 0 0 4rpx; border-radius: 20rpx 0 0; }
.selection-reticle__corner--tr { top: 0; right: 0; border-width: 4rpx 4rpx 0 0; border-radius: 0 20rpx 0 0; }
.selection-reticle__corner--bl { bottom: 0; left: 0; border-width: 0 0 4rpx 4rpx; border-radius: 0 0 0 20rpx; }
.selection-reticle__corner--br { right: 0; bottom: 0; border-width: 0 4rpx 4rpx 0; border-radius: 0 0 20rpx; }

.instruction {
  position: absolute;
  z-index: 18;
  left: 50%;
  bottom: 266rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 14rpx 22rpx;
  border-radius: 28rpx;
  color: rgba(255, 255, 255, 0.86);
  font-size: 21rpx;
  background: rgba(0, 0, 0, 0.32);
  transform: translateX(-50%);
  white-space: nowrap;
}
.instruction--active { background: rgba(0, 0, 0, 0.54); }
.instruction__state { color: #ffffff; font-size: 17rpx; font-weight: 700; letter-spacing: 1rpx; }

.bottom-controls { position: absolute; z-index: 20; left: 50%; bottom: calc(env(safe-area-inset-bottom) + 44rpx); display: flex; flex-direction: column; align-items: center; gap: 20rpx; transform: translateX(-50%); }
.bottom-hint { color: rgba(255, 255, 255, 0.68); font-size: 19rpx; text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.42); }

.clipboard-target { position: absolute; z-index: 21; top: calc(env(safe-area-inset-top) + 42rpx); right: 38rpx; display: none; width: 58rpx; height: 66rpx; border: 3rpx solid rgba(255, 255, 255, 0.9); border-radius: 11rpx; }
.clipboard-target--active { display: block; animation: clipboard-pulse 620ms ease both; }
.clipboard-target__paper { position: absolute; top: -10rpx; left: 13rpx; width: 27rpx; height: 14rpx; border-radius: 5rpx; background: #ffffff; }

@keyframes clipboard-pulse {
  0% { transform: scale(0.85); opacity: 0; }
  45% { transform: scale(1.08); opacity: 1; }
  100% { transform: scale(1); opacity: 0.75; }
}
.candidate-outline { position: absolute; inset: 0; width: 100%; height: 100%; pointer-events: none; opacity: .7; }
.candidate-outline--grabbed { opacity: 1; filter: drop-shadow(0 0 3px white); }
