<view class="preview preview--{{type}}">
  <image wx:if="{{previewImage}}" class="segmented-image" src="{{previewImage}}" mode="aspectFit" />
  <view wx:elif="{{type === 'color'}}" class="color-swatch" style="background: {{colorHex}};"></view>
  <view wx:else class="empty-preview">
    <view class="empty-preview__reticle"><view class="empty-preview__dot"></view></view>
    <text class="empty-preview__title">尚未取得真实抠图</text>
    <text class="empty-preview__hint">返回相机，将光标放在物体内部再捏合</text>
  </view>
</view>
