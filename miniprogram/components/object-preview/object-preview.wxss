.preview { position: relative; width: 390rpx; height: 420rpx; animation: float-in 560ms cubic-bezier(.2,.8,.2,1) both; }
.segmented-image { position: absolute; inset: 0; width: 100%; height: 100%; filter: drop-shadow(0 26rpx 24rpx rgba(25, 28, 31, 0.16)); }
.color-swatch { position: absolute; top: 34rpx; left: 20rpx; width: 350rpx; height: 350rpx; border: 16rpx solid #ffffff; border-radius: 50%; box-shadow: 0 30rpx 70rpx rgba(30, 33, 35, 0.12); }
.empty-preview { position: absolute; inset: 38rpx 10rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border: 2rpx dashed #cfd3d6; border-radius: 28rpx; color: #777c80; background: rgba(255, 255, 255, 0.7); }
.empty-preview__reticle { position: relative; width: 92rpx; height: 92rpx; margin-bottom: 24rpx; border: 3rpx solid #9da3a7; border-radius: 50%; }
.empty-preview__reticle::before,.empty-preview__reticle::after { content: ''; position: absolute; background: #9da3a7; }
.empty-preview__reticle::before { top: 43rpx; left: -16rpx; width: 124rpx; height: 2rpx; }
.empty-preview__reticle::after { top: -16rpx; left: 44rpx; width: 2rpx; height: 124rpx; }
.empty-preview__dot { position: absolute; top: 38rpx; left: 38rpx; width: 16rpx; height: 16rpx; border-radius: 50%; background: #656b6f; }
.empty-preview__title,.empty-preview__hint { display: block; text-align: center; }
.empty-preview__title { color: #33383b; font-size: 26rpx; font-weight: 650; }
.empty-preview__hint { width: 280rpx; margin-top: 10rpx; font-size: 19rpx; line-height: 1.5; }
@keyframes float-in { from { opacity: 0; transform: translateY(28rpx) scale(0.94); } to { opacity: 1; transform: translateY(0) scale(1); } }
